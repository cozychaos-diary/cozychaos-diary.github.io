# Only needed if you want to preview the site on your own computer
# (`bundle install` then `bundle exec jekyll serve`). GitHub Pages
# does NOT need this file to build the live site.
source "https://rubygems.org"

# The exact versions GitHub Pages uses, so local preview matches the live site.
gem "github-pages", group: :jekyll_plugins

# Needed by Jekyll's local server on Ruby 3+.
gem "webrick"
